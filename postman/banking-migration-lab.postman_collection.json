    {
      "name": "Bug demos — OLD vs NEW",
      "id": "c8a3afab-49ce-4933-87d7-0190229dd9b4",
      "description": "Run each pair back to back. The NEW request carries a test script asserting the known divergence. Full answer key: BUGS.md.",
      "item": [
        {
          "name": "BUG-01/02/04b/05a — user 3 (OLD)",
          "id": "72658582-d361-4a77-a8e3-19b09a482fbc",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{oldBase}}/api/v1/users/3",
              "host": [
                "{{oldBase}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "3"
              ]
            },
            "description": "Baseline: FullName 'Lê Ngọc Ánh', PascalCase keys, IsActive 0/1, datetime with .mmm."
          },
          "response": []
        },
        {
          "name": "BUG-01/02/04b/05a — user 3 (NEW)",
          "id": "0876c229-d911-4da5-9405-a7f31889b8bc",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{newBase}}/api/v1/users/3",
              "host": [
                "{{newBase}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "3"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('BUG-05a: keys folded to lowercase', () => pm.expect(b).to.have.property('fullname'));",
                  "pm.test('BUG-01: fullname is mojibake', () => pm.expect(b.fullname).to.not.eql('Lê Ngọc Ánh'));",
                  "pm.test('BUG-04b: isactive is boolean, not 0/1', () => pm.expect(b.isactive).to.be.a('boolean'));",
                  "pm.test('BUG-02: createdat lost milliseconds', () => pm.expect(b.createdat).to.not.match(/\\.\\d{3}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "BUG-03 — user 1 accounts (OLD)",
          "id": "40c88d21-d066-4c11-b5da-e1b38f2ddf35",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{oldBase}}/api/v1/users/1/accounts",
              "host": [
                "{{oldBase}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "1",
                "accounts"
              ]
            },
            "description": "Baseline: balance keeps 4 decimal places, e.g. 373590484.8168."
          },
          "response": []
        },
        {
          "name": "BUG-03 — user 1 accounts (NEW)",
          "id": "eb076abb-5233-42a3-88ad-7ea27a614e37",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{newBase}}/api/v1/users/1/accounts",
              "host": [
                "{{newBase}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "1",
                "accounts"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json();",
                  "pm.test('BUG-03: balance truncated to <=2dp', () => {",
                  "  rows.forEach(r => {",
                  "    const dp = (String(r.balance).split('.')[1] || '').length;",
                  "    pm.expect(dp, `account ${r.accountid}`).to.be.at.most(2);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
